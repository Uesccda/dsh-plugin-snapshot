{
  "name": "dsh-plugin-snapshot",
  "version": "0.3.5",
  "type": "module",
  "description": "Automatically checks and upgrades your installed DSH plugins: snapshot before every upgrade, automatic rollback on failure, plus one-click rollback and static diagnostics.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "snapshot",
    "rollback",
    "plugin-manager",
    "diagnostics"
  ],
  "author": "YG",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Uesccda/dsh-plugin-snapshot.git"
  },
  "homepage": "https://github.com/Uesccda/dsh-plugin-snapshot#readme",
  "bugs": {
    "url": "https://github.com/Uesccda/dsh-plugin-snapshot/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.1": "compatible",
        "0.2.1": "compatible",
        "0.2.0+": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.1 <0.4.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/plugin.test.mjs"
  }
}
